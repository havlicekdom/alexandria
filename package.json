{
  "name": "library-app",
  "version": "0.0.1",
  "description": "Simple web dashboard for library",
  "author": "Dominik Havlicek <havlicekdom@gmail.com>",
  "license": "MIT",
  "private": true,
  "engines": {
    "yarn": "1.x"
  },
  "devDependencies": {
    "@commitlint/cli": "^7.2.1",
    "@commitlint/config-conventional": "^7.1.2",
    "husky": "^7.0.4",
    "lerna": "^4.0.0",
    "lint-staged": "^8.1.4"
  },
  "scripts": {
    "start": "lerna run start --parallel",
    "build": "lerna run build --parallel",
    "lint": "lerna run lint --parallel",
    "test": "lerna run test --parallel"
  },
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "*.ts": [
      "yarn lint",
      "git add"
    ]
  }
}
